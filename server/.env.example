# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=edutrack_db

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/edutrack

# --- Auth ---
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Institution ---
SCHOOL_DOMAIN=edutrack.edu

# --- Email (fill in once you pick a provider) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@edutrack.edu
